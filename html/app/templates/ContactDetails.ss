            <div class="text-center text-heading lg:text-start">
                <h2 class="mb-4 font-playfair text-3xl">Business Hours</h2>
                <div>
                    <p>
                        $SiteConfig.BusinessHours
                    </p>
                </div>
            </div>
        </div>
    <% end_if %>
</section>
