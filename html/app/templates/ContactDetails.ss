                <% if $SiteConfig.Address %>
                    <p>
                        Address: <a class="text-body transition-colors hover:text-gold" href="$SiteConfig.AddressLink" title="Visit us"
                            >$SiteConfig.Address</a
                        >
                    </p>
                <% end_if %>
			</div>
		</div>
	</div>
    <% if $SiteConfig.BusinessHours %>
        <div
