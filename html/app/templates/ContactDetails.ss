		<div class="text-center text-heading lg:text-start">
			<h2 class="mb-4 font-playfair text-3xl">Contact Us</h2>
			<div class="space-y-1">
                <% if $SiteConfig.ContactPhone %>
                    <p>
                        Phone: <a class="text-body transition-colors hover:text-gold" href="tel:$SiteConfig.ContactPhone" title="Call us"
                            >$SiteConfig.ContactPhone</a
                        >
                    </p>
                <% end_if %>
                <% if $SiteConfig.ContactEmail %>
                    <p>
                        Email: <a
                            class="text-body transition-colors hover:text-gold"
                            href="mailto:$SiteConfig.ContactEmail" title="Email us">$SiteConfig.ContactEmail</a
                        >
                    </p>
                <% end_if %>
			</div>
		</div>
	</div>
	<div
