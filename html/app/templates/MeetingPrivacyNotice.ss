<section class="bg-white py-[3.5rem] font-garamond">
    <div class="mx-auto max-w-[1180px] px-10">
        <div class="border border-meeting-navy/[18%] p-10">
            <p class="flex flex-wrap items-baseline gap-3">
                <span class="text-[11px] uppercase tracking-[0.24em] text-meeting-gold">$Eyebrow</span>
                <span class="text-[19px] font-medium text-meeting-navy">$Heading</span>
            </p>
            <div class="mt-4 text-[16px] leading-[1.72] text-meeting-body [&_a]:text-meeting-navy [&_a]:underline [&_a]:underline-offset-2 [&_a]:hover:text-meeting-gold">
                $Content
            </div>
        </div>
    </div>
</section>
