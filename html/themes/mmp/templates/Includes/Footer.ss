            </div>
            <a
                class="col-start-1 lg:col-start-auto btn border border-gold bg-gold font-normal text-white transition-all before:bg-white hover:border-white hover:text-navy [&>*]:relative [&>*]:z-10"
                href="/contact"
                title="Book An Appointment"
            >
                <span class="relative z-10"> Book An Appointment </span>
            </a>
            <a
                class="col-start-1 lg:col-start-auto relative inline-block border border-white bg-white px-35p py-10p text-sm uppercase leading-[2.5] tracking-[1.5px] text-navy transition-colors hover:bg-transparent hover:text-white"
                href="/contact"
                title="Contact Us"
            >
                Contact Us
            </a>
            <div class="col-start-auto lg:col-start-2 xl:col-start-auto">
                <% include SocialIcons Facebook=$SiteConfig.Facebook %>
            </div>
        </div>
        <%-- Decoration Line --%>
        <div class="my-4 h-[1px] w-full bg-[#485065]"></div>
        <div
            class="grid grid-cols-1 gap-x-14 gap-y-20 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 py-12"
        >
            <div>
                <p>
                    MMP - Providing trusted legal guidance with professionalism
                    and care. Empowering you with knowledge to make informed
                    legal decisions.
                </p>
            </div>
            <div>
                <h3
                    class="font-playfair text-2xl font-bold uppercase text-heading-light"
                >
                    Quick Links
                </h3>
                <div class="my-4 h-[1px] w-full bg-[#485065]">
                    <div class="h-[1px] w-1/4 bg-gold"></div>
                </div>
                <div>
                    <ul class="space-y-2">
                        <li>
                            <a
                                class="underline-offset-4 hover:underline"
                                href="/"
                                title="About Us"
                                >About Us</a
                            >
                        </li>
                        <li>
                            <a
                                class="underline-offset-4 hover:underline"
                                href="/"
                                title="Faq"
                                >Faq</a
                            >
                        </li>
                        <li>
                            <a
                                class="underline-offset-4 hover:underline"
                                href="/"
                                title="Our Team"
                                >Our Team</a
                            >
                        </li>
                    </ul>
                </div>
            </div>
            <div>
                <h3
                    class="font-playfair text-2xl font-bold uppercase text-heading-light"
                >
                    Get In Touch
                </h3>
                <div class="my-4 h-[1px] w-full bg-[#485065]">
                    <div class="h-[1px] w-1/4 bg-gold"></div>
                </div>
                <div>
                    <ul class="space-y-5">
                        <li>
                            <a
                                class="flex items-center gap-3 underline-offset-4 hover:underline"
                                href="$SiteConfig.AddressLink"
                                title="View on google map"
                                target="_blank"
                                rel="noopener noreferrer"
                            >
                                <svg
                                    class="w-4 flex-shrink-0 fill-current text-gold"
                                    xmlns="http://www.w3.org/2000/svg"
                                    viewBox="0 0 384 512"
                                >
                                    <path
                                        d="M215.7 499.2C267 435 384 279.4 384 192C384 86 298 0 192 0S0 86 0 192c0 87.4 117 243 168.3 307.2c12.3 15.3 35.1 15.3 47.4 0zM192 128a64 64 0 1 1 0 128 64 64 0 1 1 0-128z"
                                    />
                                </svg>
                                <span>$SiteConfig.Address</span>
                            </a>
                        </li>
                        <li>
                            <a
                                class="flex items-center gap-3 underline-offset-4 hover:underline"
                                href="mailto:$SiteConfig.ContactEmail"
                                title="Email us"
                            >
                                <svg
                                    class="w-4 flex-shrink-0 fill-current text-gold"
                                    xmlns="http://www.w3.org/2000/svg"
                                    viewBox="0 0 512 512"
                                >
                                    <path
                                        d="M48 64C21.5 64 0 85.5 0 112c0 15.1 7.1 29.3 19.2 38.4L236.8 313.6c11.4 8.5 27 8.5 38.4 0L492.8 150.4c12.1-9.1 19.2-23.3 19.2-38.4c0-26.5-21.5-48-48-48H48zM0 176V384c0 35.3 28.7 64 64 64H448c35.3 0 64-28.7 64-64V176L294.4 339.2c-22.8 17.1-54 17.1-76.8 0L0 176z"
                                    />
                                </svg>
                                <span>$SiteConfig.ContactEmail</span>
                            </a>
                        </li>
                        <li>
                            <a
                                class="flex items-center gap-3 underline-offset-4 hover:underline"
                                href="tel:$SiteConfig.ContactNumber"
                                title="Call us"
                            >
                                <svg
                                    class="w-4 flex-shrink-0 fill-current text-gold"
                                    xmlns="http://www.w3.org/2000/svg"
                                    viewBox="0 0 512 512"
                                >
                                    <path
                                        d="M164.9 24.6c-7.7-18.6-28-28.5-47.4-23.2l-88 24C12.1 30.2 0 46 0 64C0 311.4 200.6 512 448 512c18 0 33.8-12.1 38.6-29.5l24-88c5.3-19.4-4.6-39.7-23.2-47.4l-96-40c-16.3-6.8-35.2-2.1-46.3 11.6L304.7 368C234.3 334.7 177.3 277.7 144 207.3L193.3 167c13.7-11.2 18.4-30 11.6-46.3l-40-96z"
                                    />
                                </svg>
                                <span>$SiteConfig.ContactNumber</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
    <div class="bg-navy-dark text-white">
        <div
            class="flex flex-col md:flex-row items-center justify-center md:justify-end text-center py-3 md:py-0 gap-3 md:gap-6 md:pr-6"
        >
            <div class="flex gap-4 items-center">
                <a
                    href="/client-care-rules"
                    class="text-white md:py-6"
                    title="Client Care Rules"
                >
                    Client Care Rules
                </a>
                <span>|</span>
                <a
                    href="/terms-of-engagement"
                    class="text-white md:py-6"
                    title="Terms of Engagement"
                >
                    Terms of Engagement
                </a>
                <span class="hidden md:block">|</span>
            </div>
            <a
                href="/privacy-policy"
                class="text-white md:py-6 w-full md:w-auto"
                title="Privacy Policy"
            >
                Privacy Policy
            </a>
        </div>
    </div>
</footer>