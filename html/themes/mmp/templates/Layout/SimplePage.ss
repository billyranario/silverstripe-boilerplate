<main class="inner-container grid grid-cols-1 gap-8 py-28 lg:grid-cols-2/1">
    <div class="space-y-12 [&>*]:border-b [&>*]:border-b-gray-border [&>*]:pb-12">
        <div>
            <div class="relative mb-8">
                <div class="mb-9 text-body">
                    $ElementalArea
                </div>
            </div>
        </div>
    </div>
</main>
